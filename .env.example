POSTGRES_DB=easy_law_ai_dev
POSTGRES_USER=easy_law_dev
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL="postgresql://easy_law_dev:change_me@localhost:5432/easy_law_ai_dev?schema=public"

# 기존 DB·볼륨 이름은 데이터 보존을 위해 유지한다.
PORT=3001
# 법규 등록을 사용할 때만 32바이트 이상 무작위 비밀값으로 설정한다.
LEGAL_INGEST_TOKEN=
# Next.js 서버 주소는 frontend/.env.example을 frontend/.env.local로 복사해 설정한다.
