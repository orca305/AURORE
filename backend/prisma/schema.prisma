generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  termChanges LegalTermHist[]
  withdrawArchDttm DateTime? @map("withdraw_arch_dttm") @db.Timestamptz(0)
  notifications UserNtf[]
  bookmarks UserBmark[]
  documents AttachDoc[]
  citationReads CiteNoticeRead[]
  id         BigInt   @id @default(autoincrement())
  loginId    String   @unique(map: "uq_app_user_login_id") @map("login_id") @db.VarChar(12)
  nickNm     String   @map("nick_nm") @db.VarChar(12)
  statCdId   BigInt   @map("stat_cd_id")
  delYn      Boolean  @default(false) @map("del_yn")
  delDttm    DateTime? @map("del_dttm") @db.Timestamptz(0)
  delId      BigInt?  @map("del_id")
  rgstDttm   DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  uptDttm    DateTime @default(now()) @updatedAt @map("upt_dttm") @db.Timestamptz(0)
  status     CmmnCd   @relation(fields: [statCdId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auth       UserAuth?
  sessions   UserSess[]
  statuses   UserStatHist[] @relation("StatusTarget")
  handledStatuses UserStatHist[] @relation("StatusActor")
  agreements UserAgrYnHist[]
  cases UserCase[]
  caseChanges CaseHist[]
  chats      ChatSess[]
  roles      UserRole[]
  precedentReviews LegalPrecReviewHist[]
  correctionActions LegalCorrHist[]
  precedentImports LegalPrecIngestHist[]

  @@map("app_user")
}

model LegalCorrHist {
  id           String   @id @db.Uuid
  reviewKey    String   @map("review_key") @db.VarChar(64)
  userId       BigInt   @map("user_id")
  legalVerId   BigInt?  @map("legal_ver_id")
  beforeHash   String   @map("before_hash") @db.VarChar(64)
  afterHash    String   @map("after_hash") @db.VarChar(64)
  statCd       String   @map("stat_cd") @db.VarChar(16)
  resultCd     String   @map("result_cd") @db.VarChar(32)
  revNo        Int?     @map("rev_no")
  affectedCnt  Int      @default(0) @map("affected_cnt")
  rgstDttm     DateTime @map("rgst_dttm") @db.Timestamptz(0)
  endDttm      DateTime @map("end_dttm") @db.Timestamptz(0)
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version      LegalVer? @relation(fields: [legalVerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([rgstDttm(sort: Desc), id(sort: Desc)], map: "idx_legal_corr_hist_date")
  @@index([legalVerId, afterHash], map: "idx_legal_corr_hist_version_hash")
  @@map("legal_corr_hist")
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  roleCdId  BigInt   @map("role_cd_id")
  rgstId    BigInt?  @map("rgst_id")
  rgstDttm  DateTime @default(dbgenerated("date_trunc('second'::text, CURRENT_TIMESTAMP)")) @map("rgst_dttm") @db.Timestamptz(0)
  delYn     Boolean  @default(false) @map("del_yn")
  delDttm   DateTime? @map("del_dttm") @db.Timestamptz(0)
  delId     BigInt?  @map("del_id")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role      CmmnCd   @relation(fields: [roleCdId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Active grants have a partial unique index in the SQL migration; revoked rows preserve history.
  @@index([userId, roleCdId], map: "idx_user_role_user_code")
  @@map("user_role")
}

model UserAuth {
  userId  BigInt  @id @map("user_id")
  pwSalt  Bytes   @map("pw_salt")
  pwHash  Bytes   @map("pw_hash")
  user    AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("user_auth")
}

model UserSess {
  tokenHash   Bytes     @id @map("token_hash")
  userId      BigInt    @map("user_id")
  rgstDttm    DateTime  @map("rgst_dttm") @db.Timestamptz(0)
  lastActDttm DateTime  @map("last_act_dttm") @db.Timestamptz(0)
  revokeDttm  DateTime? @map("revoke_dttm") @db.Timestamptz(0)
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId], map: "idx_user_sess_user")
  @@map("user_sess")
}

model UserStatHist {
  id       BigInt   @id @default(autoincrement())
  userId   BigInt   @map("user_id")
  statCdId BigInt   @map("stat_cd_id")
  prevStatCdId BigInt? @map("prev_stat_cd_id")
  actorUserId BigInt? @map("actor_user_id")
  reason String? @db.VarChar(1000)
  requestId String? @unique(map: "uq_user_stat_hist_request") @map("request_id") @db.Uuid
  requestHash String? @map("request_hash") @db.VarChar(64)
  rgstDttm DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  user     AppUser @relation("StatusTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor AppUser? @relation("StatusActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_stat_hist_actor")
  status CmmnCd @relation("StatusNext", fields: [statCdId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousStatus CmmnCd? @relation("StatusPrevious", fields: [prevStatCdId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_stat_hist_previous")

  @@index([userId, id], map: "idx_user_stat_hist_user")
  @@index([userId, rgstDttm(sort: Desc), id(sort: Desc)], map: "idx_user_stat_hist_date")
  @@map("user_stat_hist")
}

model UserAgrYnHist {
  id       BigInt   @id @default(autoincrement())
  userId   BigInt   @map("user_id")
  agrCdId  BigInt   @map("agr_cd_id")
  agrYn    Boolean  @map("agr_yn")
  polVer   String   @map("pol_ver") @db.VarChar(32)
  rgstDttm DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category CmmnCd   @relation(fields: [agrCdId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, agrCdId, id], map: "idx_user_agr_hist_user")
  @@map("user_agr_yn_hist")
}


model GuestSess {
  citationReads CiteNoticeRead[]
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   Bytes    @unique(map: "uq_guest_sess_token") @map("token_hash")
  rgstDttm    DateTime @map("rgst_dttm") @db.Timestamptz(0)
  lastActDttm DateTime @map("last_act_dttm") @db.Timestamptz(0)
  exprDttm    DateTime @map("expr_dttm") @db.Timestamptz(0)
  chats       ChatSess[]

  @@map("guest_sess")
}

model ChatSess {
  documents AttachDoc[]
  userCaseId String? @map("user_case_id") @db.Uuid
  linkedCase UserCase? @relation(fields:[userCaseId,userId],references:[id,userId],onDelete:Restrict,onUpdate:Restrict,map:"fk_chat_case_owner")
  id          String   @id @db.Uuid
  userId      BigInt?  @map("user_id")
  guestSessId String?  @map("guest_sess_id") @db.Uuid
  sessNm      String   @map("sess_nm") @db.VarChar(80)
  phaseCd     String   @default("start") @map("phase_cd") @db.VarChar(32)
  revNo       Int      @default(0) @map("rev_no")
  nextMsgSeq  Int      @default(1) @map("next_msg_seq")
  exprDttm    DateTime? @map("expr_dttm") @db.Timestamptz(0)
  delYn       Boolean  @default(false) @map("del_yn")
  delDttm     DateTime? @map("del_dttm") @db.Timestamptz(0)
  delId       BigInt?  @map("del_id")
  rgstDttm    DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  uptDttm     DateTime @default(now()) @updatedAt @map("upt_dttm") @db.Timestamptz(0)
  user        AppUser? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guest       GuestSess? @relation(fields: [guestSessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages    ChatMsg[]
  jobs        AiJob[]

  @@index([userCaseId,userId,delYn,uptDttm(sort:Desc),id(sort:Desc)],map:"idx_chat_case_list")
  @@unique([id,userId],map:"uq_chat_sess_owner")
  @@index([userId, uptDttm, id], map: "idx_chat_sess_user_date")
  @@index([guestSessId, uptDttm, id], map: "idx_chat_sess_guest_date")
  @@map("chat_sess")
}

model ChatMsg {
 clarifyCd String? @map("clarify_cd") @db.VarChar(24)
 clarifyReplyTo String? @map("clarify_reply_to") @db.Uuid
 clarificationParent ChatMsg? @relation("ClarificationReply",fields:[chatSessId,clarifyReplyTo],references:[chatSessId,id],onDelete:Restrict,onUpdate:Restrict,map:"fk_chat_msg_clarification")
 clarificationReplies ChatMsg[] @relation("ClarificationReply")
  documentQuotes DocQuote[]
  sourcedFacts CaseFact[]
  id         String   @id @default(uuid()) @db.Uuid
  chatSessId String   @map("chat_sess_id") @db.Uuid
  prntMsgId  String?  @map("prnt_msg_id") @db.Uuid
  msgSeq     Int      @map("msg_seq")
  roleCd     String   @map("role_cd") @db.VarChar(16)
  msgCont    String   @map("msg_cont") @db.Text
  delYn      Boolean  @default(false) @map("del_yn")
  delDttm    DateTime? @map("del_dttm") @db.Timestamptz(0)
  delId      BigInt?  @map("del_id")
  rgstDttm   DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  chat       ChatSess @relation(fields: [chatSessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent     ChatMsg? @relation("ChatMsgTree", fields: [chatSessId, prntMsgId], references: [chatSessId, id], onDelete: Restrict, onUpdate: Restrict)
  children   ChatMsg[] @relation("ChatMsgTree")
  inputJobs  AiJob[] @relation("JobInput")
  answerJobs AiJob[] @relation("JobAnswer")
  citations  AnsCite[]

  @@index([chatSessId,clarifyReplyTo],map:"idx_chat_msg_clarification")
  @@unique([chatSessId, id], map: "uq_chat_msg_same_chat")
  @@unique([chatSessId, msgSeq], map: "uq_chat_msg_sequence")
  @@map("chat_msg")
}

model AiJob {
  resultCd String? @map("result_cd") @db.VarChar(24)
  caseContext Json? @map("case_context") @db.JsonB
  documentLinks AiJobDoc[]
  id            String   @id @db.Uuid
  chatSessId    String   @map("chat_sess_id") @db.Uuid
  inputMsgId    String   @map("input_msg_id") @db.Uuid
  answerMsgId   String?  @map("answer_msg_id") @db.Uuid
  requestHash   String   @map("request_hash") @db.VarChar(64)
  ownerAuthHash Bytes    @map("owner_auth_hash")
  phaseCd       String   @map("phase_cd") @db.VarChar(32)
  statCd        String   @default("QUEUED") @map("stat_cd") @db.VarChar(20)
  providerCd    String   @default("DEMO") @map("provider_cd") @db.VarChar(20)
  attemptNo     Int      @default(0) @map("attempt_no")
  leaseToken    String?  @map("lease_token") @db.Uuid
  leaseDttm     DateTime? @map("lease_dttm") @db.Timestamptz(0)
  nextRunDttm   DateTime @default(now()) @map("next_run_dttm") @db.Timestamptz(0)
  deadlineDttm  DateTime @map("deadline_dttm") @db.Timestamptz(0)
  errorCd       String?  @map("error_cd") @db.VarChar(40)
  rgstDttm      DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  uptDttm       DateTime @default(now()) @updatedAt @map("upt_dttm") @db.Timestamptz(0)
  chat          ChatSess @relation(fields: [chatSessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  input         ChatMsg @relation("JobInput", fields: [chatSessId, inputMsgId], references: [chatSessId, id], onDelete: Restrict, onUpdate: Restrict)
  answer        ChatMsg? @relation("JobAnswer", fields: [chatSessId, answerMsgId], references: [chatSessId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([chatSessId,id],map:"uq_ai_job_chat")
  @@unique([chatSessId, inputMsgId], map: "uq_ai_job_input")
  @@unique([chatSessId, answerMsgId], map: "uq_ai_job_answer")
  @@index([statCd, nextRunDttm, rgstDttm], map: "idx_ai_job_queue")
  @@map("ai_job")
}

model AnsCite {
  noticeReads CiteNoticeRead[]
  id            BigInt @id @default(autoincrement())
  msgId         String @map("msg_id") @db.Uuid
  srcSnapshotId BigInt @map("src_snapshot_id")
  legalVerId    BigInt? @map("legal_ver_id")
  legalPrecId   BigInt? @map("legal_prec_id")
  citeTypeCd    String @map("cite_type_cd") @db.VarChar(16)
  citeCont      String @map("cite_cont") @db.Text
  label         String
  srcUrl        String @map("src_url")
  viewHref      String @map("view_href")
  quoteVerifyCd String @map("quote_verify_cd") @db.VarChar(24)
  supportVerifyCd String @map("support_verify_cd") @db.VarChar(24)
  rgstDttm      DateTime @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  legalRevision LegalVerRev? @relation("CitationLegalRevision", fields: [legalVerId, srcSnapshotId], references: [legalVerId, srcSnapshotId], onDelete: Restrict, onUpdate: Restrict, map: "fk_ans_cite_legal_snapshot")
  precedentRevision LegalPrecRev? @relation("CitationPrecedentRevision", fields: [legalPrecId, srcSnapshotId], references: [legalPrecId, srcSnapshotId], onDelete: Restrict, onUpdate: Restrict, map: "fk_ans_cite_prec_snapshot")
  message       ChatMsg @relation(fields: [msgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshot      SrcSnapshot @relation(fields: [srcSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version       LegalVer? @relation(fields: [legalVerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  precedent     LegalPrec? @relation(fields: [legalPrecId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([msgId], map: "uq_ans_cite_message")
  @@map("ans_cite")
}

model Legal {
  changeEvents LegalChgEvt[]
  bookmarks UserBmark[]
  id       BigInt     @id @default(autoincrement())
  srcCd    String     @default("LEGACY") @map("src_cd") @db.VarChar(60)
  srcKey   String     @map("src_key")
  legalNm  String     @map("legal_nm")
  delYn    Boolean    @default(false) @map("del_yn")
  delDttm  DateTime?  @map("del_dttm") @db.Timestamptz(0)
  delId    BigInt?    @map("del_id")
  rgstDttm DateTime   @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  uptDttm  DateTime   @default(now()) @updatedAt @map("upt_dttm") @db.Timestamptz(0)
  versions LegalVer[]

  @@unique([srcCd, srcKey], map: "uq_legal_src")
  @@map("legal")
}

model SrcSnapshot {
 terms LegalTerm[] @relation("TermSource")
 termChanges LegalTermHist[] @relation("TermHistorySource")
  noticeReads CiteNoticeRead[]
  id       BigInt     @id @default(autoincrement())
  srcCd    String     @map("src_cd") @db.VarChar(60)
  srcKey   String     @map("src_key")
  srcUrl   String     @map("src_url")
  contType String     @map("cont_type") @db.VarChar(100)
  srcCont  String     @map("src_cont") @db.Text
  contHash String     @map("cont_hash") @db.VarChar(64)
  rgstDttm DateTime   @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  revisions LegalVerRev[]
  precedentRevisions LegalPrecRev[]
  citations AnsCite[]

  @@unique([srcCd, srcKey, contHash], map: "uq_src_snapshot_content")
  @@map("src_snapshot")
}

model LegalPrec {
  changeEvents LegalChgEvt[]
  bookmarks UserBmark[]
  id         BigInt         @id @default(autoincrement())
  srcCd      String         @map("src_cd") @db.VarChar(60)
  srcKey     String         @map("src_key")
  delYn      Boolean        @default(false) @map("del_yn")
  delDttm    DateTime?      @map("del_dttm") @db.Timestamptz(0)
  delId      BigInt?        @map("del_id")
  rgstDttm   DateTime       @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  revisions  LegalPrecRev[]

  @@unique([srcCd, srcKey], map: "uq_legal_prec_source")
  citations AnsCite[]

  @@map("legal_prec")
}

model LegalPrecRev {
  changeEvents LegalChgEvt[] @relation("PrecEventSource")
  priorChangeEvents LegalChgEvt[] @relation("PrecEventBefore")
  @@unique([id,legalPrecId],map:"uq_legal_prec_rev_id_target")
  id            BigInt      @id @default(autoincrement())
  legalPrecId   BigInt      @map("legal_prec_id")
  srcSnapshotId BigInt      @map("src_snapshot_id")
  revNo         Int         @map("rev_no")
  currentYn     Boolean     @default(false) @map("current_yn")
  caseNo        String      @map("case_no")
  caseNm        String      @map("case_nm")
  courtNm       String      @map("court_nm")
  decisionDt    DateTime    @map("decision_dt") @db.Date
  issueCont     String?     @map("issue_cont") @db.Text
  summaryCont   String?     @map("summary_cont") @db.Text
  decisionCont  String      @map("decision_cont") @db.Text
  rgstDttm      DateTime    @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  precedent     LegalPrec   @relation(fields: [legalPrecId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshot      SrcSnapshot @relation(fields: [srcSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  provisionRefs LegalPrecProvi[]
  citations AnsCite[] @relation("CitationPrecedentRevision")

  @@unique([legalPrecId, revNo], map: "uq_legal_prec_rev_no")
  @@unique([legalPrecId, srcSnapshotId], map: "uq_legal_prec_rev_source")
  @@index([caseNo], map: "idx_legal_prec_rev_case_no")
  @@map("legal_prec_rev")
}

model LegalPrecProvi {
  priorReviews LegalPrecReviewHist[] @relation("PriorReference")
  nextReviews LegalPrecReviewHist[] @relation("NextReference")
  id             BigInt       @id @default(autoincrement())
  legalPrecRevId BigInt       @map("legal_prec_rev_id")
  refKey         String       @map("ref_key")
  legalProviId   BigInt?      @map("legal_provi_id")
  statCd         String       @map("stat_cd") @db.VarChar(20)
  evidenceDesc   String       @map("evidence_desc")
  delYn          Boolean      @default(false) @map("del_yn")
  delDttm        DateTime?    @map("del_dttm") @db.Timestamptz(0)
  delId          BigInt?      @map("del_id")
  rgstDttm       DateTime     @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  precedentRev   LegalPrecRev @relation(fields: [legalPrecRevId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "legal_prec_provi_legal_prec_rev_id_fkey")
  provision      LegalProvi?  @relation(fields: [legalProviId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "legal_prec_provi_legal_provi_id_fkey")

  @@map("legal_prec_provi")
}

model LegalVer {
  changeEvents LegalChgEvt[]
  id            BigInt       @id @default(autoincrement())
  legalId       BigInt       @map("legal_id")
  verKey        String       @map("ver_key")
  prmlDt        DateTime?    @map("prml_dt") @db.Date
  enfcDt        DateTime?    @map("enfc_dt") @db.Date
  delYn         Boolean      @default(false) @map("del_yn")
  delDttm       DateTime?    @map("del_dttm") @db.Timestamptz(0)
  delId         BigInt?      @map("del_id")
  rgstDttm      DateTime     @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  uptDttm       DateTime     @default(now()) @updatedAt @map("upt_dttm") @db.Timestamptz(0)
  legal         Legal        @relation(fields: [legalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions     LegalVerRev[]

  @@unique([id, legalId],map:"uq_legal_ver_id_legal")
  @@unique([legalId, verKey, enfcDt], map: "uq_legal_ver_edition")
  citations AnsCite[]

  correctionActions LegalCorrHist[]

  @@map("legal_ver")
}

model LegalVerRev {
  changeEvents LegalChgEvt[] @relation("EventSource")
  priorChangeEvents LegalChgEvt[] @relation("EventBefore")
  id            BigInt       @id @default(autoincrement())
  legalVerId    BigInt       @map("legal_ver_id")
  revNo         Int          @map("rev_no")
  srcSnapshotId BigInt?      @map("src_snapshot_id")
  currentYn     Boolean      @default(false) @map("current_yn")
  rgstDttm      DateTime     @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  version       LegalVer     @relation(fields: [legalVerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshot      SrcSnapshot? @relation(fields: [srcSnapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provisions    LegalProvi[]
  citations AnsCite[] @relation("CitationLegalRevision")

  @@unique([id, legalVerId],map:"uq_legal_ver_rev_id_version")
  @@unique([legalVerId, revNo], map: "uq_legal_ver_rev_no")
  @@unique([legalVerId, srcSnapshotId], map: "uq_legal_ver_rev_source")
  @@index([srcSnapshotId], map: "idx_legal_ver_rev_snapshot")
  @@map("legal_ver_rev")
}

model LegalProvi {
  id          BigInt       @id @default(autoincrement())
  legalVerRevId BigInt     @map("legal_ver_rev_id")
  prntProviId BigInt?      @map("prnt_provi_id")
  proviTypeCd String       @map("provi_type_cd") @db.VarChar(30)
  dispNo      String       @map("disp_no")
  normNo      String?      @map("norm_no")
  sortSeq     Int          @map("sort_seq")
  proviNm     String?      @map("provi_nm")
  proviCont   String       @map("provi_cont") @db.Text
  srcParts    Json?        @map("src_parts")
  enfcDt      DateTime?    @map("enfc_dt") @db.Date
  delYn       Boolean      @default(false) @map("del_yn")
  delDttm     DateTime?    @map("del_dttm") @db.Timestamptz(0)
  delId       BigInt?      @map("del_id")
  rgstDttm    DateTime     @default(now()) @map("rgst_dttm") @db.Timestamptz(0)
  uptDttm     DateTime     @default(now()) @updatedAt @map("upt_dttm") @db.Timestamptz(0)
  revision    LegalVerRev  @relation(fields: [legalVerRevId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent      LegalProvi?  @relation("ProviTree", fields: [prntProviId, legalVerRevId], references: [id, legalVerRevId], onDelete: Restrict, onUpdate: Restrict)
  children    LegalProvi[] @relation("ProviTree")

  precedentRefs LegalPrecProvi[]

  @@unique([id, legalVerRevId], map: "uq_legal_provi_id_rev")
  @@index([legalVerRevId, sortSeq, id], map: "idx_legal_provi_sort")
  @@map("legal_provi")
}

model CmmnCd {
