# Copy to local-dev/.env.notebook and enter the DESKTOP database credentials locally.
# SSH tunnel must already forward 15433 -> desktop DB and 18001 -> desktop AI.
DATABASE_URL=postgresql://aurore_dev_check:REPLACE_WITH_DESKTOP_PASSWORD@127.0.0.1:15433/aurore_dev_check?schema=public
AURORE_AI_URL=http://127.0.0.1:18001
BACKEND_URL=http://127.0.0.1:3001
AURORE_INTENT_CLASSIFY=0
AURORE_INTENT_ENABLE_ROUTING=0
AURORE_LAW_SNAPSHOT_DIR=
# Optional server-only Ministry API credential; never commit the real value.
MOLEG_OC=
